# Vorlage für /root/WorldMapGuessr/.env auf dem Server (die echte .env gehört NICHT ins Git).
# Host "mongo" = Containername der Datenbank im Netzwerk local-web.
# Sonderzeichen im Passwort (@ : / ? # %) müssen URL-kodiert werden.
MONGODB_URI=mongodb://wmg:PASSWORT@mongo:27017/worldmapguessr?authSource=worldmapguessr
